{
  "name": "scene-doll",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy": "npm run build && gh-pages -d dist",
    "electron:build": "node scripts/build-electron.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "npm run build && npm run electron:build && electron .",
    "desktop:dist": "npm run build && npm run electron:build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "main": "electron-dist/main.cjs",
  "description": "씬 돌 — 3D 돌 콘티 도구",
  "author": "LEEYONGSOO",
  "build": {
    "appId": "kr.greenkirin.scenedoll",
    "productName": "씬 돌",
    "artifactName": "SceneDoll-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "씬 돌",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
